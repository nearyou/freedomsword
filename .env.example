APP_ENV="staging"
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/freedomsword?retryWrites=true&w=majority"
APP_ORIGIN="https://your-app.example"
NEXT_PUBLIC_APP_URL="https://your-app.example"
TELEGRAM_AUTH_ENABLED="true"
# BotFather's bot token: server only. Set the Mini App menu URL to APP_ORIGIN in BotFather.
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"
TELEGRAM_AUTH_MAX_AGE_SECONDS="300"
SESSION_SECRET="GENERATE_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
SESSION_MAX_AGE_SECONDS="21600"
BALLOT_SECRET="GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ELIGIBILITY_COMMITMENT_SECRET="GENERATE_A_THIRD_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ELIGIBILITY_PROVIDER="mock"
RATE_LIMIT_BACKEND="mongo"
BLOCKCHAIN_ADAPTER="mock"
# For production set BLOCKCHAIN_ADAPTER="sepolia" and provide these server-only values:
BLOCKCHAIN_SEPOLIA_RPC_URL=""
BLOCKCHAIN_SIGNER_PRIVATE_KEY=""
BLOCKCHAIN_CONTRACT_ADDRESS=""
BLOCKCHAIN_CONTRACT_DEPLOYMENT_BLOCK=""
CRON_SECRET="GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_16_CHARACTERS"
LOG_LEVEL="info"
ALLOW_DEMO_AUTH="false"
