{
  "name": "freedomsword",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev -w @freedomsword/backend\" \"npm run dev -w @freedomsword/frontend\"",
    "build": "npm run build -w @freedomsword/backend && npm run build -w @freedomsword/frontend",
    "start:backend": "npm run start -w @freedomsword/backend",
    "start:frontend": "npm run start -w @freedomsword/frontend",
    "typecheck": "tsc --noEmit && npm run typecheck -w @freedomsword/backend && npm run typecheck -w @freedomsword/frontend",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run contract:test",
    "db:generate": "npm run db:generate -w @freedomsword/backend",
    "db:push": "npm run db:push -w @freedomsword/backend",
    "db:seed": "npm run db:seed -w @freedomsword/backend",
    "contract:build": "npm run contract:build -w @freedomsword/backend",
    "contract:test": "npm run contract:test -w @freedomsword/backend",
    "testnet:node": "npm run testnet:node -w @freedomsword/backend",
    "testnet:smoke": "npm run testnet:smoke -w @freedomsword/backend",
    "contract:deploy:sepolia": "npm run contract:deploy:sepolia -w @freedomsword/backend",
    "contract:deploy:rarimo-gate": "npm run contract:deploy:rarimo-gate -w @freedomsword/backend",
    "contract:deploy:rarimo-policy": "npm run contract:deploy:rarimo-policy -w @freedomsword/backend",
    "contract:link:rarimo-gate": "npm run contract:link:rarimo-gate -w @freedomsword/backend",
    "contract:link:rarimo-policy": "npm run contract:link:rarimo-policy -w @freedomsword/backend",
    "test:integration": "node scripts/integration.mjs",
    "admin:grant": "npm run admin:grant -w @freedomsword/backend",
    "audit:verify": "npm run audit:verify -w @freedomsword/backend",
    "audit:check": "npm run audit:check -w @freedomsword/backend",
    "outbox:worker": "npm run outbox:worker -w @freedomsword/backend"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "dotenv": "^16.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "concurrently": "^9.2.1"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
