APP_ENV="development"
PORT="3001"
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/freedomsword?retryWrites=true&w=majority"
APP_ORIGIN="http://localhost:3000"
TELEGRAM_AUTH_ENABLED="false"
# BotFather's bot token: server only. Set the Mini App menu URL to the frontend APP_ORIGIN in BotFather.
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"
TELEGRAM_AUTH_MAX_AGE_SECONDS="300"
SESSION_SECRET="GENERATE_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
SESSION_MAX_AGE_SECONDS="21600"
BALLOT_SECRET="GENERATE_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ELIGIBILITY_COMMITMENT_SECRET="GENERATE_A_THIRD_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ELIGIBILITY_PROVIDER="mock"
RATE_LIMIT_BACKEND="mongo"
BLOCKCHAIN_ADAPTER="mock"
# For production set BLOCKCHAIN_ADAPTER="sepolia" and provide these server-only values:
BLOCKCHAIN_SEPOLIA_RPC_URL=""
BLOCKCHAIN_SIGNER_PRIVATE_KEY=""
BLOCKCHAIN_CONTRACT_ADDRESS=""
BLOCKCHAIN_CONTRACT_DEPLOYMENT_BLOCK=""
# Local chain 31337 only. The relayer key must own LocalMaciTestGate.
# Never use the local test gate as proof of Ukrainian citizenship or age.
PRIVATE_VOTING_RPC_URL=""
PRIVATE_VOTING_SIGNER_PRIVATE_KEY=""
# Rarimo L2 (chain 7368). A deployed TD3 verifier and registry are required.
# Pin the official deployed verifier's runtime bytecode hash. The server rejects
# a configured gate whose verifier does not match this value.
RARIMO_RPC_URL=""
RARIMO_SIGNER_PRIVATE_KEY=""
RARIMO_REGISTRY_ADDRESS=""
RARIMO_VERIFIER_CODE_HASH=""
RARIMO_GATE_CODE_HASH=""
RARIMO_POLICY_CODE_HASH=""
# Deployment scripts only; set from a verified deployment/election UUID.
RARIMO_VERIFIER_ADDRESS=""
RARIMO_ELECTION_ID=""
RARIMO_ELECTION_CLOSES_AT=""
RARIMO_GATE_ADDRESS=""
RARIMO_POLICY_ADDRESS=""
RARIMO_MACI_ADDRESS=""
CRON_SECRET="GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_16_CHARACTERS"
LOG_LEVEL="info"
ALLOW_DEMO_AUTH="false"
