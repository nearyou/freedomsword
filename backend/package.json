{
  "name": "@freedomsword/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch bin/server.ts",
    "build": "prisma generate --schema prisma/schema.prisma && esbuild bin/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "contract:build": "hardhat build && node scripts/sync-contract-abi.mjs",
    "contract:test": "hardhat test solidity",
    "contract:deploy:sepolia": "npm run contract:build && tsx scripts/deploy-contract.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "audit:verify": "tsx scripts/verify-audit-export.ts",
    "audit:check": "tsx scripts/check-integrity.ts",
    "outbox:worker": "tsx scripts/outbox-worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cookie": "^1.1.1",
    "express": "^5.3.0",
    "viem": "^2.57.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "dotenv": "^16.6.0",
    "esbuild": "^0.25.12",
    "hardhat": "^3.19.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
