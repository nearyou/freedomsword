{
  "name": "@freedomsword/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch bin/server.ts",
    "build": "prisma generate --schema prisma/schema.prisma && esbuild bin/server.ts src/application.ts scripts/outbox-worker.ts prisma/seed.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --entry-names=[name]",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:support": "tsx scripts/seed-reusable-demo.ts",
    "bot:description": "tsx scripts/configure-bot-description.ts",
    "feedback:bot": "node --env-file=.env scripts/feedback-bot.mjs",
    "contract:build": "hardhat build && node scripts/sync-contract-abi.mjs",
    "contract:test": "hardhat test solidity",
    "testnet:node": "hardhat node --chain-id 31337 --hostname 127.0.0.1 --port 8545",
    "testnet:smoke": "npm run contract:build && tsx scripts/smoke-rarimo-local.ts",
    "contract:deploy:sepolia": "npm run contract:build && tsx scripts/deploy-contract.ts",
    "contract:deploy:rarimo-gate": "hardhat build && tsx scripts/deploy-rarimo-gate.ts",
    "contract:deploy:rarimo-policy": "hardhat build && tsx scripts/deploy-rarimo-policy.ts",
    "contract:link:rarimo-gate": "tsx scripts/link-rarimo-gate.ts",
    "contract:link:rarimo-policy": "tsx scripts/link-rarimo-policy.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "audit:verify": "tsx scripts/verify-audit-export.ts",
    "audit:check": "tsx scripts/check-integrity.ts",
    "outbox:worker": "tsx scripts/outbox-worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.81.5",
    "cookie": "^1.1.1",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "viem": "^2.57.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "dotenv": "^16.6.0",
    "esbuild": "^0.25.12",
    "hardhat": "^3.19.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
