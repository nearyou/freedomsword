APP_ENV="development"
# Set this in the frontend Vercel project's Environment Variables for each deployment environment.
# Use the backend's public origin only (for example, https://api.example.com), without /api or a trailing slash.
# Requests remain same-origin in the browser through the Next.js /api/* rewrite.
BACKEND_URL="http://127.0.0.1:3001"
# The frontend uses this flag only to show the local demo sign-in control.
# The backend independently enforces ALLOW_DEMO_AUTH.
ALLOW_DEMO_AUTH="false"
# Local MACI join proof artifacts. Place matching test files under public/zk/
# and use same-origin /zk/... paths. That directory is ignored by Git.
# Never use untrusted test artifacts for a production election.
NEXT_PUBLIC_MACI_JOIN_WASM_URL=""
NEXT_PUBLIC_MACI_JOIN_ZKEY_URL=""
